PORT=5000

# Local Postgres example:
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/realestate
# Hosted (Neon, Supabase, etc.): paste the connection string they give you
DATABASE_URL=

# Set to true if your host requires SSL (Neon, Supabase, Render, etc.)
DB_SSL=false

# The URL your React app runs on (Vite default), used for CORS
CLIENT_URL=http://localhost:5173
